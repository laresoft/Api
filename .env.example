# Copiá este archivo como .env y pegá acá la cadena de Supabase
# (Project Settings -> Database -> Connection string -> Session pooler)
# Nunca subas el archivo .env a GitHub.
DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Clave secreta para firmar los tokens de sesión. Generala con: openssl rand -hex 32
# Tiene que ser la MISMA en local y en Render (Environment del servicio).
JWT_SECRET=pegá_acá_una_clave_aleatoria_larga

# Recuperación de contraseña por email.
# En Render Free los puertos SMTP están bloqueados: cargá BREVO_API_KEY (API HTTPS).
# EMAIL_USER es el remitente verificado en Brevo (o tu Gmail si probás SMTP en local).
BREVO_API_KEY=pegá_acá_la_api_key_de_brevo
EMAIL_USER=tu_email_remitente@gmail.com
EMAIL_APP_PASSWORD=solo_para_probar_smtp_en_local
APP_URL=http://localhost:3000
